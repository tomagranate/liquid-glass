{
  "name": "@tomagranate/liquid-glass",
  "version": "0.0.2",
  "description": "A framework-independent liquid-glass (Apple-style refraction) effect for the web, built on the SVG feDisplacementMap filter, with React bindings and a WebGL texture backend for canvas/video.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite examples/demo",
    "build": "tsup",
    "build:demo": "vite build examples/demo",
    "build:perf": "vite build --config tests/perf/vite.config.js && node scripts/verify-perf-build.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest run --exclude '**/*.browser.test.ts' --exclude '**/*.browser.test.tsx'",
    "pretest:browser": "playwright install chromium firefox webkit",
    "test:browser": "vitest run --browser.enabled src/core/glass.browser.test.ts",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "test:perf-harness": "node --test scripts/lib/*.test.mjs",
    "test:demo:chrome": "npm run build && npm run build:demo && node scripts/browser-demo-tour.mjs --browser=chrome",
    "test:demo:firefox": "npm run build && npm run build:demo && node scripts/browser-demo-tour.mjs --browser=firefox",
    "test:demo:safari": "npm run build && npm run build:demo && node scripts/browser-demo-tour.mjs --browser=safari",
    "test:demo:all": "npm run build && npm run build:demo && node scripts/browser-demo-all.mjs",
    "perf:chrome": "node scripts/browser-perf.mjs --browser=chrome",
    "perf:firefox": "node scripts/browser-perf.mjs --browser=firefox",
    "perf:safari": "node scripts/browser-perf.mjs --browser=safari",
    "perf:all": "node scripts/browser-perf-all.mjs",
    "perf:update-baselines": "node scripts/update-perf-baselines.mjs",
    "safari-check": "scripts/safari-check",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "liquid-glass",
    "glass",
    "refraction",
    "webgl",
    "react",
    "displacement-map",
    "ui",
    "effect",
    "apple"
  ],
  "author": "Tom <tom@sunburst.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomagranate/liquid-glass.git"
  },
  "homepage": "https://github.com/tomagranate/liquid-glass#readme",
  "bugs": {
    "url": "https://github.com/tomagranate/liquid-glass/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@heroicons/react": "^2.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^3.2.6",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selenium-webdriver": "^4.45.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
